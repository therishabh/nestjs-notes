@baseUrl = http://localhost:3000

### Get all messages
GET {{baseUrl}}/messages

### Get a message by id
GET {{baseUrl}}/messages/fe4c2355-07ff-4baf-a5c9-a85c213890a

### Create a message
POST {{baseUrl}}/messages
Content-Type: application/json

{
  "message": "Hello, Second Message!",
  "category": "general"
}

### Update a message by id
PUT {{baseUrl}}/messages/1
Content-Type: application/json

{
  "text": "Updated new message!"
}
